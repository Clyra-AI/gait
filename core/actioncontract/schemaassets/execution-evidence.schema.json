{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gait.dev/schemas/v1/action-contract/execution-evidence.schema.json",
  "title": "Gait execution evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "evidence_id",
    "binding",
    "event_ref",
    "occurred_at",
    "fresh_until",
    "outcome",
    "reason_code",
    "compensation_required",
    "provenance",
    "canonical_content_digest"
  ],
  "properties": {
    "schema_id": {
      "const": "https://gait.dev/schemas/v1/action-contract/execution-evidence.schema.json"
    },
    "schema_version": {
      "const": "1"
    },
    "evidence_id": {
      "type": "string",
      "pattern": "^gait-exec-[a-f0-9]{16}$"
    },
    "binding": {
      "$ref": "#/$defs/binding"
    },
    "event_ref": {
      "$ref": "#/$defs/ref"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "fresh_until": {
      "type": "string",
      "format": "date-time"
    },
    "outcome": {
      "enum": [
        "started",
        "succeeded",
        "failed",
        "blocked"
      ]
    },
    "reason_code": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
    },
    "compensation_required": {
      "type": "boolean"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "canonical_content_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  },
  "$defs": {
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "digest"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "schema_id": {
          "type": "string"
        },
        "schema_version": {
          "type": "string"
        },
        "source_product": {
          "type": "string"
        }
      }
    },
    "execution_artifact_ref": {
      "allOf": [
        {"$ref": "#/$defs/ref"},
        {
          "required": ["schema_id", "schema_version", "source_product"],
          "properties": {
            "kind": {"const": "execution"},
            "schema_id": {"const": "https://gait.dev/schemas/v1/action-contract/execution-evidence.schema.json"},
            "schema_version": {"const": "1"},
            "source_product": {"const": "gait"}
          }
        }
      ]
    },
    "wrkr_contract_ref": {
      "allOf": [
        {
          "$ref": "#/$defs/ref"
        },
        {
          "required": [
            "schema_id",
            "schema_version",
            "source_product"
          ],
          "properties": {
            "kind": {
              "const": "action_contract"
            },
            "schema_id": {
              "const": "https://wrkr.dev/schemas/v1/proposed-action-contract-v3.schema.json"
            },
            "schema_version": {
              "const": "3"
            },
            "source_product": {
              "const": "wrkr"
            }
          }
        }
      ]
    },
    "gait_activation_ref": {
      "allOf": [
        {
          "$ref": "#/$defs/ref"
        },
        {
          "required": [
            "schema_id",
            "schema_version",
            "source_product"
          ],
          "properties": {
            "kind": {
              "const": "activated_action_contract"
            },
            "schema_id": {
              "const": "https://gait.dev/schemas/v1/activated-action-contract-artifact.schema.json"
            },
            "schema_version": {
              "const": "1"
            },
            "source_product": {
              "const": "gait"
            }
          }
        }
      ]
    },
    "gait_runtime_ref": {
      "allOf": [
        {
          "$ref": "#/$defs/ref"
        },
        {
          "required": [
            "schema_id",
            "schema_version",
            "source_product"
          ],
          "properties": {
            "kind": {
              "const": "runtime_action"
            },
            "schema_id": {
              "const": "https://gait.dev/schemas/v1/runtime-action.schema.json"
            },
            "schema_version": {
              "const": "1"
            },
            "source_product": {
              "const": "gait"
            }
          }
        }
      ]
    },
    "gait_readiness_ref": {
      "allOf": [
        {
          "$ref": "#/$defs/ref"
        },
        {
          "required": [
            "schema_id",
            "schema_version",
            "source_product"
          ],
          "properties": {
            "kind": {
              "const": "readiness"
            },
            "schema_id": {
              "const": "https://gait.dev/schemas/v1/runtime-readiness.schema.json"
            },
            "schema_version": {
              "const": "1"
            },
            "source_product": {
              "const": "gait"
            }
          }
        }
      ]
    },
    "gait_decision_ref": {
      "allOf": [
        {"$ref": "#/$defs/ref"},
        {
          "required": ["schema_id", "schema_version", "source_product"],
          "properties": {
            "kind": {"const": "decision"},
            "schema_id": {"const": "https://gait.dev/schemas/v1/runtime-readiness.schema.json"},
            "schema_version": {"const": "1"},
            "source_product": {"const": "gait"}
          }
        }
      ]
    },
    "correlation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_version",
        "binding_mode",
        "contract_ref",
        "content_digest"
      ],
      "properties": {
        "profile_version": {
          "enum": [
            "1",
            "1.0"
          ]
        },
        "binding_mode": {
          "const": "digest_bound"
        },
        "contract_ref": {
          "$ref": "#/$defs/wrkr_contract_ref"
        },
        "content_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_family_id",
        "revision",
        "contract_ref",
        "activation_ref",
        "runtime_action_ref",
        "readiness_ref",
        "decision_ref",
        "policy_ref",
        "target_ref",
        "environment_ref",
        "proof_refs",
        "causal_refs",
        "correlation"
      ],
      "properties": {
        "contract_family_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "contract_ref": {
          "$ref": "#/$defs/wrkr_contract_ref"
        },
        "activation_ref": {
          "$ref": "#/$defs/gait_activation_ref"
        },
        "runtime_action_ref": {
          "$ref": "#/$defs/gait_runtime_ref"
        },
        "readiness_ref": {
          "$ref": "#/$defs/gait_readiness_ref"
        },
        "decision_ref": {
          "$ref": "#/$defs/gait_decision_ref"
        },
        "policy_ref": {
          "$ref": "#/$defs/ref"
        },
        "target_ref": {
          "$ref": "#/$defs/ref"
        },
        "environment_ref": {
          "$ref": "#/$defs/ref"
        },
        "proof_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ref"
          }
        },
        "causal_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ref"
          }
        },
        "correlation": {
          "$ref": "#/$defs/correlation"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producer",
        "writer",
        "verifier",
        "public_key",
        "signature"
      ],
      "properties": {
        "producer": {
          "const": "gait"
        },
        "writer": {
          "type": "string",
          "minLength": 1
        },
        "verifier": {
          "type": "string",
          "minLength": 1
        },
        "public_key": {
          "type": "string",
          "minLength": 1
        },
        "signature": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "alg",
            "key_id",
            "sig",
            "signed_digest"
          ],
          "properties": {
            "alg": {
              "const": "ed25519"
            },
            "key_id": {
              "type": "string",
              "minLength": 1
            },
            "sig": {
              "type": "string",
              "minLength": 1
            },
            "signed_digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      }
    }
  }
}
