{
  "schema_id": "https://gait.dev/schemas/v1/effects/effect-contract.schema.json",
  "schema_version": "1.0.0",
  "contract_id": "effect-contract:filesystem-fixture",
  "name": "filesystem lifecycle fixture",
  "predicates": [
    {
      "id": "owner",
      "kind": "expect",
      "field": "after.owner",
      "operator": "equals",
      "expected": "owner:fixture"
    },
    {
      "id": "count",
      "kind": "invariant",
      "field": "count"
    },
    {
      "id": "identity",
      "kind": "forbid",
      "field": "after.identity",
      "operator": "equals",
      "expected": "file:deleted"
    }
  ]
}
