{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gait.dev/schemas/v1/gate/delegation_token.schema.json",
  "title": "Gate Delegation Token",
  "type": "object",
  "required": [
    "schema_id",
    "schema_version",
    "created_at",
    "producer_version",
    "token_id",
    "delegator_identity",
    "delegate_identity",
    "scope",
    "expires_at"
  ],
  "properties": {
    "schema_id": { "type": "string", "const": "gait.gate.delegation_token" },
    "schema_version": { "type": "string", "pattern": "^1\\.0\\.0$" },
    "created_at": { "type": "string", "format": "date-time" },
    "producer_version": { "type": "string" },
    "token_id": { "type": "string", "minLength": 1 },
    "delegator_identity": { "type": "string", "minLength": 1 },
    "delegate_identity": { "type": "string", "minLength": 1 },
    "scope": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "scope_class": { "type": "string" },
    "intent_digest": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "policy_digest": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
	"action_classes":{"$ref":"#/$defs/axis"},"target_scope":{"$ref":"#/$defs/axis"},"environment_scope":{"$ref":"#/$defs/axis"},"data_classes":{"$ref":"#/$defs/axis"},"network_destinations":{"$ref":"#/$defs/axis"},"max_operations":{"type":"integer","minimum":0},"max_targets":{"type":"integer","minimum":0},"max_descendant_depth":{"type":"integer","minimum":0},"contract_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},"revoked":{"type":"boolean"},"parent_token_id":{"type":"string","minLength":1},"parent_token_digest":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},"origin_authority_digest":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},"depth":{"type":"integer","minimum":0},
    "expires_at": { "type": "string", "format": "date-time" },
    "signature": {
      "type": "object",
      "required": ["alg", "key_id", "sig"],
      "properties": {
        "alg": { "type": "string" },
        "key_id": { "type": "string" },
        "sig": { "type": "string" },
        "signed_digest": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs":{"axis":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1,"pattern":"^(?!\\*$).+"}}}
}
