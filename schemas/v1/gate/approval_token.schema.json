{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gait.dev/schemas/v1/gate/approval_token.schema.json",
  "title": "Gate Approval Token",
  "type": "object",
  "required": [
    "schema_id",
    "schema_version",
    "created_at",
    "producer_version",
    "token_id",
    "approver_identity",
    "reason_code",
    "intent_digest",
    "policy_digest",
    "scope",
    "expires_at"
  ],
  "properties": {
    "schema_id": { "type": "string", "const": "gait.gate.approval_token" },
    "schema_version": { "type": "string", "pattern": "^1\\.0\\.0$" },
    "created_at": { "type": "string", "format": "date-time" },
    "producer_version": { "type": "string" },
    "token_id": { "type": "string", "minLength": 1 },
    "approver_identity": { "type": "string", "minLength": 1 },
    "reason_code": { "type": "string", "minLength": 1 },
    "intent_digest": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "policy_digest": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "delegation_binding_digest": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
	"contract_family_id": { "type": "string", "minLength": 1 }, "contract_id": { "type": "string", "minLength": 1 }, "contract_revision": { "type": "integer", "minimum": 1 },
	"proposal_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "activation_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
	"target_scope": { "$ref": "#/$defs/axis" }, "environment_scope": { "$ref": "#/$defs/axis" }, "outcome_scope": { "$ref": "#/$defs/axis" }, "effect_scope": { "$ref": "#/$defs/axis" }, "containment_scope": { "$ref": "#/$defs/axis" },
    "scope": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "max_targets": { "type": "integer", "minimum": 0 },
    "max_ops": { "type": "integer", "minimum": 0 },
    "expires_at": { "type": "string", "format": "date-time" },
    "signature": {
      "type": "object",
      "required": ["alg", "key_id", "sig"],
      "properties": {
        "alg": { "type": "string" },
        "key_id": { "type": "string" },
        "sig": { "type": "string" },
        "signed_digest": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": { "axis": { "type":"array", "minItems":1, "uniqueItems":true, "items":{"type":"string","minLength":1,"pattern":"^(?!\\*$).+"} } },
  "allOf": [{ "if": { "anyOf": [{"required":["contract_family_id"]},{"required":["contract_id"]},{"required":["contract_revision"]},{"required":["proposal_digest"]},{"required":["activation_digest"]},{"required":["target_scope"]},{"required":["environment_scope"]},{"required":["outcome_scope"]},{"required":["effect_scope"]},{"required":["containment_scope"]}] }, "then": { "required":["contract_family_id","contract_id","contract_revision","proposal_digest","activation_digest","target_scope","environment_scope","outcome_scope","effect_scope","containment_scope"] } }]
}
