#!/bin/sh
set -e

# Client-side hooks inherit repository-local Git variables. Clear them before
# running checks that create and inspect their own temporary repositories.
unset $(git rev-parse --local-env-vars)

mode="${GAIT_PREPUSH_MODE:-fast}"

if [ "$mode" = "full" ]; then
  echo "[gait] running pre-push checks (full): make prepush-full"
  make prepush-full
  exit 0
fi

echo "[gait] running pre-push checks (fast): make prepush"
make prepush
